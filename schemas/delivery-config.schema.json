{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "profile": {
      "type": "string",
      "enum": [
        "portable",
        "openspec"
      ]
    },
    "spec": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "native",
            "openspec",
            "custom"
          ]
        },
        "minimum_cli_version": {
          "type": "string"
        },
        "directory": {
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "profiles_file": {
          "type": "string",
          "minLength": 1
        },
        "role_skills_file": {
          "type": "string",
          "minLength": 1
        },
        "fail_on_missing_required": {
          "type": "boolean"
        },
        "project_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "profiles_file",
        "role_skills_file",
        "fail_on_missing_required",
        "project_skills"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "daemon_mode": {
          "type": "string",
          "enum": [
            "detached",
            "foreground"
          ]
        },
        "max_parallel_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "default_worker_timeout_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "worker_termination_grace_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_task_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "no_progress_cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_dynamic_tasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_dynamic_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_duration_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_total_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "repository": {
          "type": "object",
          "properties": {
            "max_active_write_runs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "max_active_write_runs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "daemon_mode",
        "max_parallel_workers",
        "default_worker_timeout_seconds",
        "worker_termination_grace_seconds",
        "max_task_attempts",
        "no_progress_cycles",
        "max_dynamic_tasks",
        "max_dynamic_depth",
        "max_duration_hours",
        "max_total_tokens",
        "repository"
      ],
      "additionalProperties": false
    },
    "workers": {
      "type": "object",
      "properties": {
        "default_profile": {
          "type": "string",
          "minLength": 1
        },
        "planner_profile": {
          "type": "string",
          "minLength": 1
        },
        "implementer_profile": {
          "type": "string",
          "minLength": 1
        },
        "debugger_profile": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_profile": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_profile": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "default_profile",
        "planner_profile",
        "implementer_profile",
        "debugger_profile",
        "reviewer_profile",
        "acceptance_profile"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "execution": {
          "type": "object",
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "container",
                "trusted-host"
              ]
            },
            "image": {
              "type": "string"
            },
            "command": {
              "type": "string"
            }
          },
          "required": [
            "backend"
          ],
          "additionalProperties": false
        },
        "baseline": {
          "type": "boolean"
        },
        "commands": {
          "type": "object",
          "properties": {
            "build": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "test": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lint": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "e2e": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "build",
            "test",
            "lint",
            "e2e"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "baseline",
        "commands"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "blocking_severities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          }
        },
        "task_review_policy": {
          "type": "string",
          "enum": [
            "risk-based",
            "always",
            "batch"
          ]
        },
        "final_review": {
          "type": "boolean"
        }
      },
      "required": [
        "blocking_severities",
        "task_review_policy",
        "final_review"
      ],
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "prepare-only",
            "commit",
            "branch",
            "push",
            "merge"
          ]
        },
        "worktree_isolation": {
          "type": "boolean"
        },
        "delete_worktree_on_success": {
          "type": "boolean"
        },
        "final_artifact": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "worktree_isolation",
        "delete_worktree_on_success",
        "final_artifact"
      ],
      "additionalProperties": false
    },
    "notifications": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "status-only"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "profile",
    "spec",
    "capabilities",
    "runtime",
    "workers",
    "verification",
    "review",
    "git",
    "notifications"
  ],
  "additionalProperties": false
}
