{
  "name": "dsh-delivery-loop",
  "version": "0.2.0",
  "description": "Resumable, verifiable end-to-end software delivery for DeepSeek Harness: task graph, subagent workers, independent verification, review, and acceptance",
  "type": "module",
  "private": false,
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "delivery",
    "workflow",
    "orchestration",
    "subagents"
  ],
  "author": "loveowie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loveowie/delivery-loop.git"
  },
  "homepage": "https://github.com/loveowie/delivery-loop#readme",
  "bugs": {
    "url": "https://github.com/loveowie/delivery-loop/issues"
  },
  "main": "dist/dsh/host.js",
  "exports": {
    ".": "./dist/dsh/host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "assets/icon-*.png",
    "capabilities",
    "client.js",
    "cordis.patch.yml",
    "dist",
    "examples",
    "icon.svg",
    "locale",
    "schemas",
    "scripts",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/*.md",
    "docs/design/*.md",
    "docs/reports/*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "verify:skills": "tsx scripts/sync-vendored-skills.ts --check",
    "update:skills": "tsx scripts/sync-vendored-skills.ts --write",
    "test": "tsx --test --import ./tests/setup-env.ts tests/*.test.ts tests/**/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "demo:view": "tsx scripts/create-view-demo.ts",
    "test:integration": "tsx --test --import ./tests/setup-env.ts tests/e2e/*.test.ts tests/workspace/*real-git.test.ts tests/workers/*process*.test.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "license": "MIT"
}
