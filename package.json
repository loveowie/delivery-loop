{
  "name": "delivery-loop",
  "version": "0.2.0",
  "description": "Native DeepSeek Harness end-to-end delivery orchestration with DSH subagent workers and a delivery view",
  "type": "module",
  "private": false,
  "main": "dist/dsh/host.js",
  "exports": {
    ".": "./dist/dsh/host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "capabilities",
    "client.js",
    "cordis.patch.yml",
    "dist",
    "examples",
    "icon.svg",
    "locale",
    "schemas",
    "scripts",
    "skills",
    "README.md",
    "readme-cn.md",
    "LICENSE",
    "docs/*.md",
    "docs/design/*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "verify:skills": "tsx scripts/sync-vendored-skills.ts --check",
    "update:skills": "tsx scripts/sync-vendored-skills.ts --write",
    "test": "tsx --test tests/*.test.ts tests/**/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "demo:view": "tsx scripts/create-view-demo.ts",
    "test:integration": "tsx --test tests/e2e/*.test.ts tests/workspace/*real-git.test.ts tests/workers/*process*.test.ts",
    "verify:release": "tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
